<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A tool, not a library and not a test project: never packed, never published,
         and dotnet test must not pick it up (spec 008 R1.1, design § 1). -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Crystal's public API only, as a product would use it (R1.1). Nothing else of Crystal's. -->
    <ProjectReference Include="..\..\src\SystemD.Crystal\SystemD.Crystal.csproj" />
  </ItemGroup>

</Project>
