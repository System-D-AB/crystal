<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The RocksDB binding's size-estimate call takes pinned key/length arrays and an output
         buffer by pointer (spec 001-2 R2.3); NativeRocks.ApproximateSizes needs unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Package metadata (spec 001 R5.1). One package, SystemD.Crystal, with symbols. Publishing always needs the
       maintainer's explicit approval (playbook § 5). CrystalVersion.Value must equal <Version> (VersionTests). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>SystemD.Crystal</PackageId>
    <Version>1.0.0-rc.2</Version>
    <Authors>SystemD.Crystal contributors</Authors>
    <Description>An embeddable storage engine for .NET, built on a write-ahead log over RocksDB: databases, boxes (named ordered key spaces) and records; atomic batches across boxes; snapshots and bounded ordered scans; durability you choose; primary/standby replication; incremental online backup and restore; format stamps.</Description>
    <PackageTags>storage;embedded;key-value;database;rocksdb;wal;replication;backup</PackageTags>
    <PackageProjectUrl>https://github.com/System-D-AB/crystal</PackageProjectUrl>
    <PackageReleaseNotes>First 1.0 release candidate: the full storage kernel (stores, databases, boxes, batches, snapshots, forward and backward scans, range size estimates, box and key locks, durability modes, observability, self-describing databases, replication with handover, backup and restore). Tested on Windows and Linux. See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/System-D-AB/crystal.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PackageReadme.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RocksDB" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- InternalsVisibleTo for the test projects (design § 5): the smoke test and
       architecture tests reach internal SystemD.Crystal.Storage types. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SystemD.Crystal.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SystemD.Crystal.Architecture.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The crash host sets the internal test hook on CrystalOptions (spec 005 design addendum A8). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SystemD.Crystal.CrashHost</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
